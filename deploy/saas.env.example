# Sovereign-OS hosted control plane — required configuration.
# The app refuses to start without the first of these; the second is checked and warned
# about. Both exist because the failure they prevent is silent: everything keeps working
# and a guarantee quietly stops being true.

# Encrypts tenant provider keys at rest. Generate once, keep it in your host's secret
# manager, and do not rotate casually — existing ciphertext is keyed to it.
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SOVEREIGN_SAAS_SECRET=

# Turns "no tenant key in the current context" from a silent fallback to the platform's
# own API key into a hard failure. Required whenever more than one customer is served:
# without it a mission that crosses a thread boundary bills the operator instead of the
# tenant, and nothing reports a problem.
SOVEREIGN_MULTI_TENANT=1

# Where tenant data directories live. Must be a persistent volume — it holds each
# tenant's ledger, audit trail, trust store, and learned cost calibration. Losing it
# resets every tenant's cost estimates to the uncalibrated heuristic.
SOVEREIGN_SAAS_ROOT=/data/tenants

# Set to 1 only when running behind a proxy that sets X-Forwarded-For. Trusting that
# header without one lets any caller forge a fresh identity per request, which makes
# rate limiting decorative.
SOVEREIGN_TRUST_PROXY=0

PORT=8020
